# Copiar como ".env" y ajustar.
# local = datos simulados en localStorage | http = backend real
VITE_MODO_DATOS=local
# URL base de la API (obligatoria cuando VITE_MODO_DATOS=http)
VITE_API_URL=http://localhost:8080/api/v1
# Retardo artificial (ms) del modo local para simular red
VITE_LATENCIA_MS=300
